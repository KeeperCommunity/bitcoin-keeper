+    if (!keeper_der_take(&tbs, 0x02, &ignored) || !keeper_der_take(&tbs, 0x30, &ignored) ||
+        !keeper_der_take(&tbs, 0x30, &ignored) || !keeper_der_take(&tbs, 0x30, &validity)) return 0;
