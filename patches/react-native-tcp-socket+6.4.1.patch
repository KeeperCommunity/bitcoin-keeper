+/* Keep system/user roots except the roots withdrawn by Node's October 2026 fix.
+ * A peer-supplied chain often omits its root, so checking only that chain is insufficient. */
+final class KeeperTrustPolicy {
+    private static final String[] WITHDRAWN = {
+        "86a1ecba089c4a8d3bbe2734c612ba341d813e043cf9e8a862cd5c57a36bbe6b",
+        "125609aa301da0a249b97a8239cb6a34216f44dcac9f3954b14292f2e8c8608f",
+        "bc4d809b15189d78db3e1d8cf4f9726a795da1643ca5f1358e1ddb0edc0d7eb3"
+    };
+
+    private static final String[] COMPROMISED_KEYS = {
+        "ebed6475c2c2d80fcb199f3fe8dd6e6b3ce60b77eb15d4e42c3dec0c6f5b5105",
+        "49dd353dc2b919a3770645117d0e60c16115e7d1bc259eefe734b00ea434fe5f",
+        "e0254c7fcdc265e2f0f8a428dabb75ab4ae039b4872d62f5ee57f0877d5a8a41",
+        "5c0660a2b164910d8ff589c18e14552e9e0ec237dcefe2cb736d41a4811f81a0",
+        "ec4ffa1ad0ac88081314b7aaffef6a91f97cd57291bb5ba686c5415f5eb4f6b6",
+        "92c063d67e8f14db71d288e11266ffdaf69cbf115f7bab14f3bc2f68d25e0e30",
+        "43bffa19d6ef651451f6841e019931e96f6f2eaeff28ab4b6f1ce4576de2717b",
+        "63ecefee431d49523bc1136c4e72d0206a477086caf606cd5cf025686c109cf8"
+    };
+
+    private static String fingerprint(byte[] encoded) throws GeneralSecurityException {
+        byte[] digest = MessageDigest.getInstance("SHA-256").digest(encoded);
+        StringBuilder hex = new StringBuilder();
+        for (byte value : digest) hex.append(String.format(java.util.Locale.ROOT, "%02x", value & 0xff));
+        return hex.toString();
+    }
+
+    static void checkCertificate(X509Certificate certificate) throws GeneralSecurityException {
+        try {
+            certificate.checkValidity();
+        } catch (CertificateException invalid) {
+            throw new CertificateException("TLS certificate validity check failed", invalid);
+        }
+        String certHash = fingerprint(certificate.getEncoded());
+        String keyHash = fingerprint(certificate.getPublicKey().getEncoded());
+        for (String withdrawn : WITHDRAWN) {
+            if (withdrawn.equals(certHash)) throw new CertificateException("Withdrawn TLS trust anchor");
+        }
+        for (String compromised : COMPROMISED_KEYS) {
+            if (compromised.equals(keyHash)) throw new CertificateException("Compromised TLS certificate key");
+        }
+    }
+
+    static TrustManager[] trustManagers(KeyStore explicitStore) throws GeneralSecurityException {
+        TrustManagerFactory defaults = TrustManagerFactory.getInstance(TrustManagerFactory.getDefaultAlgorithm());
+        defaults.init((KeyStore) null);
+        KeyStore filtered = explicitStore;
+        if (filtered == null) {
+            try {
+                filtered = KeyStore.getInstance(KeyStore.getDefaultType());
+                filtered.load(null, null);
+                int index = 0;
+                for (TrustManager manager : defaults.getTrustManagers()) {
+                    if (manager instanceof X509TrustManager) {
+                        for (X509Certificate root : ((X509TrustManager) manager).getAcceptedIssuers()) {
+                            try {
+                                checkCertificate(root);
+                                filtered.setCertificateEntry("keeper-root-" + index++, root);
+                            } catch (CertificateException excluded) {
+                                // Expired or withdrawn roots do not establish trust.
+                            }
+                        }
+                    }
+                }
+            } catch (java.io.IOException error) {
+                throw new GeneralSecurityException(error);
+            }
+        } else {
+            java.util.Enumeration<String> aliases = filtered.aliases();
+            while (aliases.hasMoreElements()) {
+                X509Certificate certificate = (X509Certificate) filtered.getCertificate(aliases.nextElement());
+                if (certificate != null) checkCertificate(certificate);
+            }
+        }
+        TrustManagerFactory factory = TrustManagerFactory.getInstance(TrustManagerFactory.getDefaultAlgorithm());
+        factory.init(filtered);
+        return factory.getTrustManagers();
+    }
+}
