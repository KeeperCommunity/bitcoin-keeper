--- /dev/null
+++ b/node_modules/react-native-tcp-socket/ios/KeeperCertificatePolicy.h
@@ -0,0 +1,91 @@
+#ifndef KEEPER_CERTIFICATE_POLICY_H
+#define KEEPER_CERTIFICATE_POLICY_H
+#include <stddef.h>
+#include <stdint.h>
+
+/* Read only DER definite, minimally encoded TLVs. Security.framework parses X.509;
+ * this bounded reader additionally checks validity of explicitly trusted anchors. */
+typedef struct { const uint8_t *data; size_t size; } KeeperDER;
+static int keeper_der_take(KeeperDER *input, unsigned tag, KeeperDER *value) {
+    if (input->size < 2 || input->data[0] != tag) return 0;
+    size_t offset = 2, length = input->data[1];
+    if (length & 0x80) {
+        size_t count = length & 0x7f;
+        if (!count || count > sizeof(size_t) || count > input->size - 2 || !input->data[2]) return 0;
+        length = 0;
+        for (size_t i = 0; i < count; ++i) {
+            if (length > (SIZE_MAX >> 8)) return 0;
+            length = (length << 8) | input->data[offset++];
+        }
+        if (length < 128) return 0;
+    }
+    if (length > input->size - offset) return 0;
+    value->data = input->data + offset;
+    value->size = length;
+    input->data += offset + length;
+    input->size -= offset + length;
+    return 1;
+}
+static int keeper_decimal(const uint8_t *text, size_t count) {
+    int value = 0;
+    for (size_t i = 0; i < count; ++i) {
+        if (text[i] < '0' || text[i] > '9') return -1;
+        value = value * 10 + text[i] - '0';
+    }
+    return value;
+}
+static int keeper_der_time(KeeperDER *input, int64_t *epoch) {
+    if (!input->size) return 0;
+    unsigned tag = input->data[0];
+    size_t yearDigits = tag == 0x17 ? 2 : tag == 0x18 ? 4 : 0;
+    KeeperDER text;
+    if (!yearDigits || !keeper_der_take(input, tag, &text) || text.size != yearDigits + 11 ||
+        text.data[text.size - 1] != 'Z') return 0;
+    int year = keeper_decimal(text.data, yearDigits);
+    if (year < 0) return 0;
+    if (yearDigits == 2) year += year < 50 ? 2000 : 1900;
+    int month = keeper_decimal(text.data + yearDigits, 2);
+    int day = keeper_decimal(text.data + yearDigits + 2, 2);
+    int hour = keeper_decimal(text.data + yearDigits + 4, 2);
+    int minute = keeper_decimal(text.data + yearDigits + 6, 2);
+    int second = keeper_decimal(text.data + yearDigits + 8, 2);
+    static const int days[] = { 31,28,31,30,31,30,31,31,30,31,30,31 };
+    int leap = year % 4 == 0 && (year % 100 != 0 || year % 400 == 0);
+    if (year < 1 || month < 1 || month > 12 || day < 1 ||
+        day > days[month - 1] + (month == 2 && leap) || hour < 0 || hour > 23 ||
+        minute < 0 || minute > 59 || second < 0 || second > 59) return 0;
+    /* Proleptic Gregorian civil date to days since 1970-01-01. */
+    year -= month <= 2;
+    int era = year / 400;
+    unsigned yearOfEra = (unsigned)(year - era * 400);
+    unsigned dayOfYear = (153 * (month + (month > 2 ? -3 : 9)) + 2) / 5 + day - 1;
+    unsigned dayOfEra = yearOfEra * 365 + yearOfEra / 4 - yearOfEra / 100 + dayOfYear;
+    *epoch = ((int64_t)era * 146097 + dayOfEra - 719468) * 86400 + hour * 3600 + minute * 60 + second;
+    return 1;
+}
+static int keeper_certificate_spki(const uint8_t *bytes, size_t size, KeeperDER *spki) {
+    KeeperDER input = { bytes, size }, certificate, tbs, ignored;
+    if (!keeper_der_take(&input, 0x30, &certificate) || input.size ||
+        !keeper_der_take(&certificate, 0x30, &tbs)) return 0;
+    if (tbs.size && tbs.data[0] == 0xa0 && !keeper_der_take(&tbs, 0xa0, &ignored)) return 0;
+    if (!keeper_der_take(&tbs, 0x02, &ignored) || !keeper_der_take(&tbs, 0x30, &ignored) ||
+        !keeper_der_take(&tbs, 0x30, &ignored) || !keeper_der_take(&tbs, 0x30, &ignored) ||
+        !keeper_der_take(&tbs, 0x30, &ignored)) return 0;
+    const uint8_t *start = tbs.data;
+    if (!keeper_der_take(&tbs, 0x30, &ignored)) return 0;
+    spki->data = start;
+    spki->size = (size_t)(tbs.data - start);
+    return 1;
+}
+static int keeper_certificate_is_current(const uint8_t *bytes, size_t size, int64_t now) {
