FROM node:22-bookworm-slim@sha256:43ac6c60b8f89723f746e8a92ce91abd5017e627ce1ddfe4238355d3a30b772c
WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci --ignore-scripts
COPY tsconfig.json ./
COPY src ./src
COPY scripts/local-entry.cjs ./scripts/local-entry.cjs
RUN npm run compile && mkdir /local-data && chown node:node /local-data /app
ENV NODE_ENV=development
USER node
CMD ["node", "scripts/local-entry.cjs"]
