FROM node:22.23.4-bookworm-slim@sha256:de170b39439eb0e5a3444ad7d60b015614a381e10fecae2e30ec9e735122f38d
WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci --ignore-scripts
COPY tsconfig.json ./
COPY src ./src
COPY scripts/local-entry.cjs ./scripts/local-entry.cjs
RUN npm run compile && mkdir /local-data && chown node:node /local-data /app
ENV NODE_ENV=development
USER node
CMD ["node", "scripts/local-entry.cjs"]
